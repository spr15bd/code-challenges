var displayTree = tree => console.log(JSON.stringify(tree, null, 2));
function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  let nodes = []
  this.traverse = function (root) {
    // start by adding the root node to a queue
    let queue = [root]
    while (queue.length>0) {
      console.log("queue is now ", queue, " (", queue.length, " values)")
      let root = queue.shift()
      // dequeue the first item in the queue, add it to a new array
      nodes.push(root.value)
      console.log("nodes: ", nodes)
      // inspect subtrees
      if (root.left) {
        queue.push(root.left)
      }
      if (root.right) {
        queue.push(root.right)
      }
    }
    return nodes
  }  

  this.levelOrder = function() {
    if (!this.root) return null

    return this.traverse(this.root)
  }

  this.reverseLevelOrder = function() {
    if (!this.root) return null

    return this.reverseTraverse(this.root)
  }

  this.reverseTraverse = function (root) {
    let queue = [root]
    while (queue.length>0) {
      console.log("queue is now ", queue, " (", queue.length, " values)")
      let root = queue.pop()
      // dequeue the first item in the queue, add it to a new array
      nodes.push(root.value)
    }
    console.log("nodes: ", nodes)
    // inspect subtrees
    if (root.left) {
      queue.push(root.left)
    }
    if (root.right) {
      queue.push(root.right)
    }
    return nodes
  }
  // Only change code above this line
}


