var displayTree = tree => console.log(JSON.stringify(tree, null, 2));
function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.traversedNodes = []
  this.traverse = function (direction, root) {
    const queue = [root];

    if (direction === 'levelOrder') {
      let root = queue.shift()
      this.traversedNodes.push(root.value)
      console.log("Root value ", root.value, ", nodes: ", this.traversedNodes)
      if (root.left) {
        this.addLeft(root.left)
      }
      if (root.right) {
        this.addRight(root.right)
      }
      console.log("Root value ", root.value, ", nodes: ", this.traversedNodes)
    }

    this.addLeft = function(node) {
      this.traversedNodes.push(node.left)
    }

    this.addRight = function(node) {
      this.traversedNodes.push(node.right)
    }
  }

  // Level order traversal
  this.levelOrder = function () {
    if (!this.root) return null;
    
    return this.traverse("levelOrder", this.root);
  }
  // Only change code above this line
}


