var displayTree = tree => console.log(JSON.stringify(tree, null, 2));
function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}

function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.remove = function (targetNode) {
    console.log("removing: ", targetNode)
    if (!this.root) return null
    let foundTargetNode = false
    // keep track of the parent of node being deleted
    // find node
    let oldRoot = null
    let remainingTree = this.root

    while (!foundTargetNode) {
      if (remainingTree.value === targetNode) { // found the node we're looking for
        console.log("found ", targetNode)
        foundTargetNode = true
      } else if (targetNode<remainingTree.value) { // didn't find it
        console.log("didnt find node")
        if (!remainingTree.left) return null
        this.oldRoot = remainingTree
        remainingTree = remainingTree.left
      } else {
        if (!remainingTree.right) return null
        this.oldRoot = remainingTree
        remainingTree = remainingTree.right
      }
    }
    console.log("end of while, remaining tree ", remainingTree)
    remainingTree.value = null
    if (!remainingTree.left?.value && !remainingTree.right?.value) {
      // set parent to null
      remainingTree = null
      console.log("after deletion, root is now ", this.root)
    }
  }
}



