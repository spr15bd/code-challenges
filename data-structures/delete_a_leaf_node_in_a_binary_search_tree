function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}

function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.remove = function (targetNode) {
    console.log("removing: ", targetNode)
    if (!this.root) return null
    console.log(this.root)
    // find node
    while (targetNode !== this.root.value) {
      if (this.root.value === targetNode) {
      if (!this.root.left && !this.root.right) {
        this.root = null
      }
    } else if (targetNode<this.root.value) {
      targetNode = this.root.left
    } else {
      targetNode = this.root.right
    }
    }
  }
}



