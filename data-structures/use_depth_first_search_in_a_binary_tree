function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.inorder = function() {
    if (!this.root) {
      return null
    }
    let nodes = []
    descendTree(this.root)
    console.log("nodes is now ", nodes)
    return nodes
    function descendTree(node) { 
      // route traversal
      if (node.left) {
        descendTree(node.left)
      }
      if (node.value) {
        nodes.push(node.value)
      }
      if (node.right) {
        descendTree(node.right)
      }
    }
  }
  this.preorder = function() {
    if (!this.root) {
      return null
    }
    let nodes = []
  }
