var displayTree = tree => console.log(JSON.stringify(tree, null, 2));
function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.inorder = function() {
    if (!this.root) {
      return null
    }
    let nodes = []
    return descendTree(this.root)
    function descendTree(node) {
      if (!node) {
        return []
      }
      
      // route traversal
      if (node.left) {
        console.log("left node found: ", node.left.value)
        console.log("pushing ", descendTree(node.left))
        nodes.push(descendTree(node.left))
        return node.value
      } else if (node.right) {
        console.log("right node found: ", node.right.value)
        nodes.push(descendTree(node.right))
        return node.value
      } else {
        console.log("reached the bottom, adding ", node.value)
        return node.value
      }
    }
  }
  // Only change code above this line
}


