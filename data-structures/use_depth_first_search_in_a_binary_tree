function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.inorder = function() {
    if (!this.root) {
      return null
    }
    let nodes = []
    descendTree(this.root)
    console.log("nodes is now ", nodes)
    return nodes
    function descendTree(node) {
      //if (!node) {
      //  return []
      //}
      
      // route traversal
      if (node.left) {
        descendTree(node.left)
        console.log("after left, nodes is now ", nodes)
        nodes.push(node.value)
        console.log("centre, nodes is now ", nodes)
        descendTree(node.right)
        console.log("after right, nodes is now ", nodes)
      } else if (node.right) {
        console.log("right node found: ", node.right.value)
        nodes.push(descendTree(node.right))
      } else {
        console.log("reached the bottom, adding ", node.value)
        nodes.push(node.value)
      }
    }
  }
  // Only change code above this line
}


