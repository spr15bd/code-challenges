        //target.value.parent = parent
        console.log("subtree is now: ", parent)
        console.log("we need to delete the original 15")
        
        console.log("leaf is ", minSubTree)
      }
    }
  };
  this.findMin = function(tree) {
    console.log("finding min in tree with root node: ", tree.value)
    let currentMin
    let currentNode
    let currentNodeParent
    currentNode = tree
    currentMin = tree.value
    let minNode
    while (currentNode) {
      if (currentNode.left || currentNode.right) {
        currentNodeParent = currentNode
      }
      currentNode = currentNode?.left
      if (currentNode) {
        currentMin = currentNode?.value
        minNode = currentNode
      }
    }
    return [currentMin, currentNodeParent]
  }
}





