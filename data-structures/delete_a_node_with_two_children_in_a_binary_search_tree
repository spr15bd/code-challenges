        console.log("tree has 3 nodes")
        this.root = null
      } else {
        console.log("tree has > 3 nodes, target: ", target)
        let minSubTree = this.findMin(target.right)[0]
        let minParentTree = this.findMin(target.right)[1]
        console.log("min's parent tree: ", minParentTree)
        // replace the target node with the smallest value in right subtree
        console.log("parent of target is ", parent)
