var Node = function() {
  this.keys = new Map();
  this.end = false;
  this.setEnd = function() {
    this.end = true;
  };
  this.isEnd = function() {
    return this.end;
  };
};
var Trie = function() {
  // Only change code below this line
  this.nodes = []
  this.add = function(word) {
    let n = new Node()
    this.nodes.push(addWord(word, n))
    function addWord(word, root) {
      const currentNode = root
      // add 1st letter of word to the node
      currentNode.keys.set(1, word[0])
      // pop 1st letter
      word = word.substring(1,word.length)
      console.log("word is now: ", word)
      // if word length is zero return
      if (word.length === 0) {
        return root
      } else {
        addWord(word, n)
      }
    }
  }
  this.print = function() {
    console.log("Nodes ", this.nodes[0])
    return this.nodes
  }
  this.isWord = function() {
    return false
  }
  // Only change code above this line
};

let trie = new Trie()
trie.add("word")
trie.print()
