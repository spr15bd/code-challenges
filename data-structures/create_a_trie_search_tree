var Node = function() {
  this.keys = new Map();
  this.end = false;
  this.setEnd = function() {
    this.end = true;
  };
  this.isEnd = function() {
    return this.end;
  };
};
var Trie = function() {
  // Only change code below this line
  this.nodes = []
  this.add = function(word) {
    let n = new Node()
    let addW = addWord(word, n)
    console.log("added: ", addW)
    this.nodes.push(addW)
    function addWord(word, root) {
      const currentNode = root
      // add 1st letter of word to the node
      currentNode.keys['letter'] = word[0]
      console.log("currentNode is: ", currentNode)
      // pop 1st letter
      word = word.substring(1,word.length)
      console.log("currentNode is now: ", currentNode)
      // if word length is zero return
      if (word.length === 0) {
        return currentNode
      } else {
        return addWord(word, currentNode)
      }
    }
  }
  this.print = function() {
    console.log("Nodes ", this.nodes)
    return this.nodes
  }
  this.isWord = function() {
    return false
  }
  // Only change code above this line
};

let trie = new Trie()
trie.add("word")
trie.print()
