function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.invertTree = function () {
    if (!this.root) {
      return null
    }
    this.invert(this.root)
  }
  this.invert = function (tree) {
    if (tree.left) {
      let temp = tree.left.value
      tree.right.value = tree.left.value
      tree.left.value = temp
      this.invert(tree.left)
    }
    if (tree.right) {
      let temp = tree.left.value
      tree.right.value = tree.left.value
      tree.left.value = temp
      this.invert(tree.left)
    }
  }
  // Only change code above this line
}
