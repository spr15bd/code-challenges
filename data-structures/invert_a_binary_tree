function Node(value) {
  this.value = value;
  this.left = null;
  this.right = null;
}
function BinarySearchTree() {
  this.root = null;
  // Only change code below this line
  this.invert = function () {
    if (!this.root) {
      return null
    }
    return this.invertTree(this.root)
  }
  this.invertTree = function (tree) {
    let temp = tree.left
    tree.left = tree.right
    tree.right = temp
    if (tree.left) this.invertTree(tree.left)
    if (tree.right) this.invertTree(tree.right)
  }
  // Only change code above this line
}
